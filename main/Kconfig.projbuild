menu "VoiceLife"

choice VOICELIFE_BOARD
    prompt "Board assembly"
    default VOICELIFE_BOARD_VOICELIFE_PCB
    help
        构建期选定板级装配：Runtime 只依赖 PlatformAssembly 接口，
        不判断板型、不直接调用具体显示实现。

config VOICELIFE_BOARD_VOICELIFE_PCB
    bool "VoiceLife PCB（SSD1306 点阵屏）"

config VOICELIFE_BOARD_ESP_SPARKBOT
    bool "ESP-SparkBot（ST7789/LVGL 彩屏）"

endchoice

config VOICELIFE_IM_GATEWAY
    bool "Enable VoiceLife Gateway IM runtime"
    default n
    help
        Assemble the base IM runtime from the encrypted `im` NVS namespace.
        Missing or invalid configuration degrades IM without stopping local
        voice/audio. No schedule receipt, notification or SSE action task is
        started by this option.

config VOICELIFE_AUDIO_PROBE
    bool "Enable ESP32-S3 audio wiring probe"
    default n
    help
        Run the bounded I2S topology, PCM evidence and optional replay probe.

config VOICELIFE_AUDIO_PORT_SMOKE
    bool "Enable ESP32-S3 PCM Audio Port smoke"
    default n
    depends on IDF_TARGET_ESP32S3
    help
        Exercise the profile-driven PCM Audio Port with separate capture and
        playback tasks. This proves digital I2S and bounded queue behavior;
        it does not prove acoustic playback or a cloud voice session.

config VOICELIFE_STATE_FLOW_TEST
    bool "Enable SparkBot interaction state-flow diagnostic"
    default n
    depends on VOICELIFE_BOARD_ESP_SPARKBOT
    help
        Run a finite, low-priority diagnostic sequence through Runtime's
        InteractionEventLoop and VoiceSession evidence inlet. It never calls
        a renderer, presentation port, GPIO, or audio output directly. This
        is a test-only build option and must remain disabled in production.

config VOICELIFE_SERIAL_VOICE_TEST
    bool "Enable SparkBot serial PCM voice regression harness"
    default n
    depends on VOICELIFE_BOARD_ESP_SPARKBOT && ESP_CONSOLE_USB_SERIAL_JTAG && !VOICELIFE_STATE_FLOW_TEST
    help
        Start a test-only USB Serial/JTAG PCM input reader. It accepts a fixed,
        bounded 16 kHz S16LE mono protocol and routes frames through the normal
        audio queue, VoiceSession, Linx transport and ES8311 output. The test
        build emits unredacted voice text and detailed hardware telemetry for
        board diagnosis. It must remain disabled in production profiles.

config VOICELIFE_MCP_TOOLS
    bool "Enable VoiceLife MCP tool advertisement"
    default y
    help
        Register VoiceLife MCP tools while keeping the MCP worker available.
        Profiles that require an empty tool catalog must explicitly set this
        option to n.

if VOICELIFE_AUDIO_PROBE

choice VOICELIFE_AUDIO_PROBE_PROFILE
    prompt "Audio probe profile"
    default VOICELIFE_AUDIO_PROBE_PROFILE_LICHUANG

config VOICELIFE_AUDIO_PROBE_PROFILE_LICHUANG
    bool "ESP32-S3 Lichuang external Codec duplex"

config VOICELIFE_AUDIO_PROBE_PROFILE_VOICELIFE_PCB
    bool "ESP32-S3 VoiceLife PCB direct I2S simplex"

endchoice

config VOICELIFE_AUDIO_PROBE_REPLAY
    bool "Replay one attenuated captured PCM frame"
    default n
    help
        Write one bounded, attenuated frame after capture. This is a bus-level
        smoke only and never proves that the speaker was acoustically heard.

endif

endmenu
