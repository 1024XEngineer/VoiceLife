POSTGRES_USER=voicelife
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=voicelife
DATABASE_URL=postgresql://voicelife:replace-with-a-random-password@127.0.0.1:5432/voicelife

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3000
ACTION_TOKEN_SECRET=replace-me
# Optional; when omitted, purpose-separated keys derive from ACTION_TOKEN_SECRET.
IDENTITY_SECRET=replace-me

# dev:wechat only: non-secret selector for a device created by `pnpm device -- create`.
WECHAT_DEV_DEVICE_ID=replace-with-registered-test-device-id
WECHAT_TEST_OPENID=replace-with-test-user-openid
WECHAT_CHANNEL_ACCOUNT_ID=wechat-production
WECHAT_APP_ID=replace-with-wechat-app-id
WECHAT_APP_SECRET=replace-with-wechat-app-secret
WECHAT_WEBHOOK_TOKEN=replace-with-wechat-webhook-token
WECHAT_WEBHOOK_MODE=plain
WECHAT_EXPECTED_TO_USERNAME=gh_replace_with_original_account_id
WECHAT_TEMPLATE_ID=replace-with-template-id
WECHAT_TEMPLATE_TITLE_FIELD=first
WECHAT_TEMPLATE_BODY_FIELD=keyword1
WECHAT_TEMPLATE_TIME_FIELD=keyword2
# 独立的日程查询结果模板；提醒和日程变更回执仍使用上面的模板。
WECHAT_QUERY_TEMPLATE_ID=replace-with-query-template-id
WECHAT_QUERY_TEMPLATE_TITLE_FIELD=first
WECHAT_QUERY_TEMPLATE_BODY_FIELD=keyword1
WECHAT_QUERY_TEMPLATE_TIME_FIELD=keyword2
# IANA 时区；模板中的 UTC 提醒时间将格式化为本地展示时间。
WECHAT_DISPLAY_TIME_ZONE=Asia/Shanghai
WECHAT_ACTION_UI_BASE_URL=https://gateway.example/voicelife/reminder-actions

# scripts/provision_device.py 使用；部署信息不写死在脚本中，由 .env 提供。
PROVISION_SERVER=replace-with-user@gateway-server
PROVISION_SERVER_DIR=/root/XE6-15
# Optional; when omitted, the origin is derived from WECHAT_ACTION_UI_BASE_URL.
# PROVISION_GATEWAY_ORIGIN=https://gateway.example
