PORT=3000
DATABASE_PATH=./data/calendar.sqlite
APP_TIME_ZONE=Asia/Shanghai
MCP_SHARED_SECRET=replace-with-a-long-random-value
DEMO_MODE=true
SCHEDULER_INTERVAL_MS=1000
