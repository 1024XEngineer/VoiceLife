# macOS 灵矽主动语音客户端（默认关闭）
LINX_PROACTIVE_VOICE=false
LINX_DEVICE_OTA_URL=https://xrobo.qiniuapi.com/v1/ota/
LINX_DEVICE_WS_URL=wss://xrobo-io.qiniuapi.com/v1/ws/
LINX_DEVICE_WS_TOKEN=
LINX_DEVICE_ID=
LINX_DEVICE_CLIENT_ID=
LINX_AGENT_ID=
LINX_VOICE_ID=
LINX_VOICE_TIMEOUT_MS=30000
