{
  "name": "linx-voice-calendar-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "linx:copy-token": "tsx src/scripts/copy-linx-mcp-token.ts",
    "linx:voice:activate": "tsx src/scripts/activate-linx-voice-client.ts",
    "linx:voice:test": "tsx src/scripts/test-linx-voice-client.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "luxon": "3.7.2",
    "opusscript": "0.1.1",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.2",
    "@types/node": "26.1.1",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.1",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
