{
  "schemaVersion": 2,
  "id": "esp32s3-lichuang-audio-probe",
  "boardId": "esp32s3-lichuang",
  "boardRevision": "unknown",
  "target": "esp32s3",
  "capabilities": ["pcm-probe", "external-codec-duplex", "atomic-calendar-write"],
  "resourceBudget": {
    "flashBytes": 16777216,
    "psramBytes": 8388608
  },
  "adapters": {
    "audio": {
      "driver": "esp32s3-pcm-probe",
      "capabilities": ["pcm-probe", "external-codec-duplex"],
      "configRef": "env://VOICELIFE_AUDIO_PROFILE"
    },
    "speech": {
      "driver": "scaffold",
      "capabilities": []
    },
    "storage": {
      "driver": "memory",
      "capabilities": ["atomic-calendar-write"]
    },
    "im": {
      "driver": "disabled",
      "capabilities": []
    },
    "display": {
      "driver": "disabled",
      "capabilities": []
    },
    "input": {
      "driver": "disabled",
      "capabilities": []
    },
    "wake": {
      "driver": "disabled",
      "capabilities": []
    },
    "connectivity": {
      "driver": "disabled",
      "capabilities": []
    }
  },
  "sdkconfig": [
    "CONFIG_LOG_DEFAULT_LEVEL_INFO=y",
    "CONFIG_VOICELIFE_AUDIO_PROBE=y",
    "CONFIG_VOICELIFE_AUDIO_PROBE_PROFILE_LICHUANG=y"
  ]
}
