{
  "schemaVersion": 1,
  "id": "esp32s3-voicelife-pcb-pcm",
  "target": "esp32s3",
  "adapters": {
    "audio": {
      "driver": "esp32s3-pcm-port",
      "capabilities": [
        "pcm-port",
        "bounded-input",
        "bounded-output",
        "direct-i2s-simplex",
        "transport-frame-assembly"
      ],
      "configRef": "env://VOICELIFE_AUDIO_PROFILE"
    },
    "speech": {
      "driver": "scaffold",
      "capabilities": []
    },
    "storage": {
      "driver": "memory",
      "capabilities": ["atomic-calendar-write"]
    },
    "im": {
      "driver": "disabled",
      "capabilities": []
    }
  },
  "sdkconfig": [
    "CONFIG_LOG_DEFAULT_LEVEL_INFO=y",
    "CONFIG_VOICELIFE_AUDIO_PROBE=y",
    "CONFIG_VOICELIFE_AUDIO_PROBE_PROFILE_VOICELIFE_PCB=y",
    "CONFIG_VOICELIFE_AUDIO_PROBE_REPLAY=y",
    "CONFIG_VOICELIFE_AUDIO_PORT_SMOKE=y"
  ]
}
