menu "VoiceLife SQLite board probe"

config SQLITE_PROBE_PARTITION_LABEL
    string "Data partition label"
    default "voicelife"
    help
        Label of the existing 2 MiB data partition used by the probe.
        It must match --data-label passed to scripts/sqlite_board_probe.py.

config SQLITE_PROBE_ALLOW_FORMAT
    bool "Allow the probe to initialize its backed-up test partition"
    default y
    help
        This is only for the destructive board fixture. The host tool must back
        up and verify the selected partition before booting the probe.
        Production storage adapters must keep format_if_mount_failed disabled.

endmenu
