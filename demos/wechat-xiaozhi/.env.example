# HTTP
PORT=8787
BASE_URL=http://localhost:8787
DATA_FILE=./data/state.json
DEVICE_API_KEY=change-me
DEMO_MODE=true
IM_RUNTIME=koishi-satori

# 微信公众平台“服务器配置”
WECHAT_ACCOUNT=gh_公众号原始ID
WECHAT_TOKEN=voicelife-demo-token
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 公众平台 EncodingAESKey，43 个字符；留空时只能使用明文模式
WECHAT_AES_KEY=

# mock：不调用微信，只记录发送；live：调用真实微信 API
WECHAT_OUTBOUND_MODE=mock
WECHAT_TEMPLATE_ID=
# 以下字段名必须改成实际获批模板的字段名
WECHAT_TEMPLATE_TITLE_FIELD=thing1
WECHAT_TEMPLATE_TIME_FIELD=time2
WECHAT_TEMPLATE_STATUS_FIELD=thing3
# 公网 HTTPS 操作页，模板消息点击后打开
WECHAT_TEMPLATE_DETAIL_URL=https://your-domain.example/reminders/action
# 可选；默认复用 DEVICE_API_KEY。生产环境建议设置独立随机密钥
WECHAT_ACTION_TOKEN_SECRET=
WECHAT_ACTION_TOKEN_TTL_SECONDS=604800

# Koishi HTTP / Satori
KOISHI_SELF_URL=https://your-domain.example
SATORI_PATH=/satori
SATORI_TOKEN=replace-with-random-token

# 小智控制台“配置角色”中的 MCP 接入点 WebSocket URL
XIAOZHI_MCP_ENDPOINT=
# 这个 MCP 连接所代表的小智设备 ID
XIAOZHI_DEVICE_ID=xiaozhi-demo-01
# 打印收到的 MCP 方法名和连接诊断，不会打印 token
XIAOZHI_MCP_DEBUG=false
